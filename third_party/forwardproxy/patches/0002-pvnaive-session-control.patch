diff --git a/pvnaive_session_control.go b/pvnaive_session_control.go
new file mode 100644
index 0000000..8ba6ec0
--- /dev/null
+++ b/pvnaive_session_control.go
@@ -0,0 +1,231 @@
+package forwardproxy
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"sync"
+	"time"
+)
+
+const pvnaiveSessionControlMaxRequestBytes = 8 << 10
+
+type pvnaiveSessionTuple struct {
+	RuntimeCredentialID string
+	NodeID              string
+	BootID              string
+	SessionID           string
+}
+
+type pvnaiveLiveSession struct {
+	conn   net.Conn
+	killed bool
+	once   sync.Once
+}
+
+type pvnaiveSessionRegistry struct {
+	mu   sync.Mutex
+	live map[pvnaiveSessionTuple]*pvnaiveLiveSession
+}
+
+func newPVNaiveSessionRegistry() *pvnaiveSessionRegistry {
+	return &pvnaiveSessionRegistry{live: make(map[pvnaiveSessionTuple]*pvnaiveLiveSession)}
+}
+
+func (r *pvnaiveSessionRegistry) register(key pvnaiveSessionTuple, conn net.Conn, _ *pvnaiveAccountingSession) {
+	if r == nil || conn == nil {
+		return
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.live[key] = &pvnaiveLiveSession{conn: conn}
+}
+
+func (r *pvnaiveSessionRegistry) unregister(key pvnaiveSessionTuple) {
+	if r == nil {
+		return
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	delete(r.live, key)
+}
+
+func (r *pvnaiveSessionRegistry) kill(key pvnaiveSessionTuple) (found bool, killed bool) {
+	if r == nil {
+		return false, false
+	}
+	r.mu.Lock()
+	live := r.live[key]
+	if live == nil {
+		r.mu.Unlock()
+		return false, false
+	}
+	if live.killed {
+		r.mu.Unlock()
+		return true, false
+	}
+	live.killed = true
+	r.mu.Unlock()
+
+	live.once.Do(func() {
+		_ = live.conn.Close()
+	})
+	return true, true
+}
+
+func (h *Handler) registerPVNaiveSession(conn net.Conn, accountingSession *pvnaiveAccountingSession) func() {
+	if h == nil || h.pvnaiveSessions == nil || conn == nil || accountingSession == nil || accountingSession.client == nil {
+		return func() {}
+	}
+	key := pvnaiveSessionTuple{RuntimeCredentialID: accountingSession.runtimeCredentialID, NodeID: accountingSession.client.nodeID, BootID: accountingSession.client.bootID, SessionID: accountingSession.sessionID}
+	h.pvnaiveSessions.register(key, conn, accountingSession)
+	return func() { h.pvnaiveSessions.unregister(key) }
+}
+
+type pvnaiveSessionControlServer struct {
+	path       string
+	listener   net.Listener
+	httpServer *http.Server
+	socketInfo os.FileInfo
+	closeOnce  sync.Once
+	closeErr   error
+}
+
+type pvnaiveSessionControlRequest struct {
+	RuntimeCredentialID string `json:"runtime_credential_id"`
+	NodeID              string `json:"node_id"`
+	BootID              string `json:"boot_id"`
+	SessionID           string `json:"session_id"`
+}
+
+type pvnaiveSessionControlResult struct {
+	Found  bool `json:"found"`
+	Killed bool `json:"killed"`
+}
+
+func startPVNaiveSessionControlServer(path string, registry *pvnaiveSessionRegistry) (*pvnaiveSessionControlServer, error) {
+	if path == "" {
+		return nil, errors.New("pvnaive: session-control socket path is required")
+	}
+	if registry == nil {
+		return nil, errors.New("pvnaive: session-control registry is required")
+	}
+	if err := preparePVNaiveSessionControlSocket(path); err != nil {
+		return nil, err
+	}
+	listener, err := net.Listen("unix", path)
+	if err != nil {
+		return nil, fmt.Errorf("pvnaive: listen session-control socket: %w", err)
+	}
+	cleanup := true
+	defer func() {
+		if cleanup {
+			_ = listener.Close()
+			_ = os.Remove(path)
+		}
+	}()
+	if err := os.Chmod(path, 0o660); err != nil {
+		return nil, fmt.Errorf("pvnaive: chmod session-control socket: %w", err)
+	}
+	info, err := os.Lstat(path)
+	if err != nil {
+		return nil, fmt.Errorf("pvnaive: stat session-control socket: %w", err)
+	}
+
+	server := &pvnaiveSessionControlServer{path: path, listener: listener, socketInfo: info}
+	server.httpServer = &http.Server{
+		Handler:           newPVNaiveSessionControlHandler(registry),
+		ReadHeaderTimeout: 2 * time.Second,
+		IdleTimeout:       5 * time.Second,
+	}
+	go func() {
+		_ = server.httpServer.Serve(listener)
+	}()
+	cleanup = false
+	return server, nil
+}
+
+func preparePVNaiveSessionControlSocket(path string) error {
+	info, err := os.Lstat(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return fmt.Errorf("pvnaive: stat session-control socket: %w", err)
+	}
+	if info.Mode()&os.ModeSocket == 0 {
+		return errors.New("pvnaive: session-control path exists and is not a socket")
+	}
+	conn, dialErr := net.DialTimeout("unix", path, 150*time.Millisecond)
+	if dialErr == nil {
+		_ = conn.Close()
+		return errors.New("pvnaive: session-control socket is already active")
+	}
+	if err := os.Remove(path); err != nil {
+		return fmt.Errorf("pvnaive: remove stale session-control socket: %w", err)
+	}
+	return nil
+}
+
+func newPVNaiveSessionControlHandler(registry *pvnaiveSessionRegistry) http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("/v1/sessions/kill", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			w.Header().Set("Allow", http.MethodPost)
+			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		body := http.MaxBytesReader(w, r.Body, pvnaiveSessionControlMaxRequestBytes)
+		defer body.Close()
+		decoder := json.NewDecoder(body)
+		decoder.DisallowUnknownFields()
+		var req pvnaiveSessionControlRequest
+		if err := decoder.Decode(&req); err != nil {
+			http.Error(w, "invalid request", http.StatusBadRequest)
+			return
+		}
+		if err := decoder.Decode(&struct{}{}); !errors.Is(err, io.EOF) {
+			http.Error(w, "invalid request", http.StatusBadRequest)
+			return
+		}
+		if req.RuntimeCredentialID == "" || req.NodeID == "" || req.BootID == "" || req.SessionID == "" {
+			http.Error(w, "incomplete session tuple", http.StatusBadRequest)
+			return
+		}
+		found, killed := registry.kill(pvnaiveSessionTuple{
+			RuntimeCredentialID: req.RuntimeCredentialID,
+			NodeID:              req.NodeID,
+			BootID:              req.BootID,
+			SessionID:           req.SessionID,
+		})
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(pvnaiveSessionControlResult{Found: found, Killed: killed})
+	})
+	return mux
+}
+
+func (s *pvnaiveSessionControlServer) Close() error {
+	if s == nil {
+		return nil
+	}
+	s.closeOnce.Do(func() {
+		if s.httpServer != nil {
+			s.closeErr = s.httpServer.Close()
+		} else if s.listener != nil {
+			s.closeErr = s.listener.Close()
+		}
+		current, err := os.Lstat(s.path)
+		if err == nil && s.socketInfo != nil && os.SameFile(s.socketInfo, current) {
+			if removeErr := os.Remove(s.path); removeErr != nil && !errors.Is(removeErr, os.ErrNotExist) && s.closeErr == nil {
+				s.closeErr = removeErr
+			}
+		} else if err != nil && !errors.Is(err, os.ErrNotExist) && s.closeErr == nil {
+			s.closeErr = err
+		}
+	})
+	return s.closeErr
+}
