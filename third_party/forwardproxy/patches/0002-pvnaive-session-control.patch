diff --git a/pvnaive_session_control.go b/pvnaive_session_control.go
new file mode 100644
--- /dev/null
+++ b/pvnaive_session_control.go
@@ -0,0 +1,69 @@
+package forwardproxy
+
+import (
+	"net"
+	"sync"
+)
+
+type pvnaiveSessionTuple struct {
+	RuntimeCredentialID string
+	NodeID              string
+	BootID              string
+	SessionID           string
+}
+
+type pvnaiveLiveSession struct {
+	conn   net.Conn
+	killed bool
+	once   sync.Once
+}
+
+type pvnaiveSessionRegistry struct {
+	mu   sync.Mutex
+	live map[pvnaiveSessionTuple]*pvnaiveLiveSession
+}
+
+func newPVNaiveSessionRegistry() *pvnaiveSessionRegistry {
+	return &pvnaiveSessionRegistry{live: make(map[pvnaiveSessionTuple]*pvnaiveLiveSession)}
+}
+
+func (r *pvnaiveSessionRegistry) register(key pvnaiveSessionTuple, conn net.Conn, _ *pvnaiveAccountingSession) {
+	if r == nil || conn == nil {
+		return
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.live[key] = &pvnaiveLiveSession{conn: conn}
+}
+
+func (r *pvnaiveSessionRegistry) unregister(key pvnaiveSessionTuple) {
+	if r == nil {
+		return
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	delete(r.live, key)
+}
+
+func (r *pvnaiveSessionRegistry) kill(key pvnaiveSessionTuple) (found bool, killed bool) {
+	if r == nil {
+		return false, false
+	}
+	r.mu.Lock()
+	live := r.live[key]
+	if live == nil {
+		r.mu.Unlock()
+		return false, false
+	}
+	if live.killed {
+		r.mu.Unlock()
+		return true, false
+	}
+	live.killed = true
+	r.mu.Unlock()
+
+	live.once.Do(func() {
+		_ = live.conn.Close()
+	})
+	return true, true
+}
diff --git a/pvnaive_session_control_test.go b/pvnaive_session_control_test.go
new file mode 100644
--- /dev/null
+++ b/pvnaive_session_control_test.go
@@ -0,0 +1,89 @@
+package forwardproxy
+
+import (
+	"net"
+	"sync/atomic"
+	"testing"
+)
+
+type pvnaiveTrackedConn struct {
+	net.Conn
+	closes atomic.Int32
+}
+
+func (c *pvnaiveTrackedConn) Close() error {
+	c.closes.Add(1)
+	return c.Conn.Close()
+}
+
+func pvnaiveTask13Key(sessionID string) pvnaiveSessionTuple {
+	return pvnaiveSessionTuple{
+		RuntimeCredentialID: "11111111-1111-4111-8111-111111111111",
+		NodeID:              "node-a",
+		BootID:              "22222222-2222-4222-8222-222222222222",
+		SessionID:           sessionID,
+	}
+}
+
+func TestPVNaiveSessionRegistryExactKillKeepsSiblingAlive(t *testing.T) {
+	registry := newPVNaiveSessionRegistry()
+	aClient, aServer := net.Pipe()
+	bClient, bServer := net.Pipe()
+	defer aClient.Close()
+	defer bClient.Close()
+	target := &pvnaiveTrackedConn{Conn: aServer}
+	sibling := &pvnaiveTrackedConn{Conn: bServer}
+	targetKey := pvnaiveTask13Key("33333333-3333-4333-8333-333333333333")
+	siblingKey := pvnaiveTask13Key("44444444-4444-4444-8444-444444444444")
+	registry.register(targetKey, target, nil)
+	registry.register(siblingKey, sibling, nil)
+
+	found, killed := registry.kill(targetKey)
+	if !found || !killed {
+		t.Fatalf("target kill found=%v killed=%v want true/true", found, killed)
+	}
+	if got := target.closes.Load(); got != 1 {
+		t.Fatalf("target closes=%d want 1", got)
+	}
+	if got := sibling.closes.Load(); got != 0 {
+		t.Fatalf("sibling closes=%d want 0", got)
+	}
+}
+
+func TestPVNaiveSessionRegistryForgedTupleCannotKill(t *testing.T) {
+	registry := newPVNaiveSessionRegistry()
+	client, server := net.Pipe()
+	defer client.Close()
+	conn := &pvnaiveTrackedConn{Conn: server}
+	realKey := pvnaiveTask13Key("33333333-3333-4333-8333-333333333333")
+	registry.register(realKey, conn, nil)
+	forged := realKey
+	forged.BootID = "99999999-9999-4999-8999-999999999999"
+
+	found, killed := registry.kill(forged)
+	if found || killed {
+		t.Fatalf("forged kill found=%v killed=%v want false/false", found, killed)
+	}
+	if got := conn.closes.Load(); got != 0 {
+		t.Fatalf("real session closes=%d want 0", got)
+	}
+}
+
+func TestPVNaiveSessionRegistryRepeatKillIsIdempotent(t *testing.T) {
+	registry := newPVNaiveSessionRegistry()
+	client, server := net.Pipe()
+	defer client.Close()
+	conn := &pvnaiveTrackedConn{Conn: server}
+	key := pvnaiveTask13Key("33333333-3333-4333-8333-333333333333")
+	registry.register(key, conn, nil)
+
+	if found, killed := registry.kill(key); !found || !killed {
+		t.Fatalf("first kill found=%v killed=%v want true/true", found, killed)
+	}
+	if found, killed := registry.kill(key); !found || killed {
+		t.Fatalf("second kill found=%v killed=%v want true/false", found, killed)
+	}
+	if got := conn.closes.Load(); got != 1 {
+		t.Fatalf("close count=%d want 1", got)
+	}
+}
