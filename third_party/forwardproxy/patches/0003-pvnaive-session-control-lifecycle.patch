+)
 
 type pvnaiveSessionTuple struct {
 	RuntimeCredentialID string
@@ -95,6 +98,93 @@ type pvnaiveSessionControlServer struct {
 	closeErr   error
 }
 
+type pvnaiveSessionControlShared struct {
+	server   *pvnaiveSessionControlServer
+	registry *pvnaiveSessionRegistry
+	refs     int
+}
+
+type pvnaiveSessionControlManager struct {
+	mu     sync.Mutex
+	byPath map[string]*pvnaiveSessionControlShared
+}
+
+var pvnaiveSessionControls = pvnaiveSessionControlManager{byPath: make(map[string]*pvnaiveSessionControlShared)}
+
+type pvnaiveSessionControlLease struct {
+	path   string
+	shared *pvnaiveSessionControlShared
+	once   sync.Once
+	err    error
+}
+
+func acquirePVNaiveSessionControl(path string) (*pvnaiveSessionControlLease, *pvnaiveSessionRegistry, error) {
+	pvnaiveSessionControls.mu.Lock()
+	defer pvnaiveSessionControls.mu.Unlock()
+	if shared := pvnaiveSessionControls.byPath[path]; shared != nil {
+		shared.refs++
+		return &pvnaiveSessionControlLease{path: path, shared: shared}, shared.registry, nil
+	}
+	registry := newPVNaiveSessionRegistry()
+	server, err := startPVNaiveSessionControlServer(path, registry)
+	if err != nil {
+		return nil, nil, err
+	}
+	shared := &pvnaiveSessionControlShared{server: server, registry: registry, refs: 1}
+	pvnaiveSessionControls.byPath[path] = shared
+	return &pvnaiveSessionControlLease{path: path, shared: shared}, registry, nil
+}
+
+func (l *pvnaiveSessionControlLease) Close() error {
+	if l == nil {
+		return nil
+	}
+	l.once.Do(func() {
+		pvnaiveSessionControls.mu.Lock()
+		defer pvnaiveSessionControls.mu.Unlock()
+		shared := pvnaiveSessionControls.byPath[l.path]
+		if shared == nil || shared != l.shared {
+			return
+		}
+		shared.refs--
+		if shared.refs > 0 {
+			return
+		}
+		delete(pvnaiveSessionControls.byPath, l.path)
+		l.err = shared.server.Close()
+	})
+	return l.err
+}
+
+func (h *Handler) provisionPVNaiveSessionControl() error {
+	return h.provisionPVNaiveSessionControlAt(pvnaiveSessionControlSocketPath)
+}
+
+func (h *Handler) provisionPVNaiveSessionControlAt(path string) error {
+	if h == nil || h.pvnaiveAccountingClient == nil {
+		return nil
+	}
+	if h.pvnaiveSessionControl != nil {
+		return nil
+	}
+	lease, registry, err := acquirePVNaiveSessionControl(path)
+	if err != nil {
+		return err
+	}
+	h.pvnaiveSessions = registry
+	h.pvnaiveSessionControl = lease
+	return nil
+}
+
+func (h *Handler) Cleanup() error {
+	if h == nil || h.pvnaiveSessionControl == nil {
+		return nil
+	}
+	lease := h.pvnaiveSessionControl
+	h.pvnaiveSessionControl = nil
+	return lease.Close()
+}
+
 type pvnaiveSessionControlRequest struct {
