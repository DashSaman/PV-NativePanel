+func pvnaiveShortSocketPath(t *testing.T) string {
+	t.Helper()
+	f, err := os.CreateTemp("", "pv-t13-*.sock")
+	if err != nil {
+		t.Fatalf("create short socket path: %v", err)
+	}
+	path := f.Name()
+	if err := f.Close(); err != nil {
+		t.Fatalf("close temp socket placeholder: %v", err)
+	}
+	if err := os.Remove(path); err != nil {
+		t.Fatalf("remove temp socket placeholder: %v", err)
+	}
+	t.Cleanup(func() { _ = os.Remove(path) })
+	return path
+}
+
+func TestPVNaiveSessionControlLeaseKeepsSocketAcrossReload(t *testing.T) {
+	path := pvnaiveShortSocketPath(t)
+	lease1, registry1, err := acquirePVNaiveSessionControl(path)
+	if err != nil {
+		t.Fatalf("acquire first lease: %v", err)
+	}
+	lease2, registry2, err := acquirePVNaiveSessionControl(path)
+	if err != nil {
+		_ = lease1.Close()
+		t.Fatalf("acquire successor lease: %v", err)
+	}
+	if registry1 != registry2 {
+		t.Fatal("reload successor must share live registry")
+	}
+	if err := lease1.Close(); err != nil {
+		t.Fatalf("close predecessor: %v", err)
+	}
+	if _, err := os.Lstat(path); err != nil {
+		_ = lease2.Close()
+		t.Fatalf("predecessor removed successor socket: %v", err)
+	}
+	if err := lease2.Close(); err != nil {
+		t.Fatalf("close successor: %v", err)
+	}
+	if _, err := os.Lstat(path); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("last lease must remove socket, stat=%v", err)
+	}
+}
+
+func TestPVNaiveSessionControlProvisionOnlyForAccountingHandler(t *testing.T) {
+	path := pvnaiveShortSocketPath(t)
+	h := &Handler{}
+	if err := h.provisionPVNaiveSessionControlAt(path); err != nil {
+		t.Fatalf("non-accounting provision: %v", err)
+	}
+	if _, err := os.Lstat(path); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("non-accounting handler created control socket: %v", err)
+	}
+	h.pvnaiveAccountingClient = &pvnaiveAccountingClient{}
+	if err := h.provisionPVNaiveSessionControlAt(path); err != nil {
+		t.Fatalf("accounting provision: %v", err)
+	}
+	if h.pvnaiveSessions == nil || h.pvnaiveSessionControl == nil {
+		t.Fatal("accounting handler must own shared registry lease")
+	}
+	if _, err := os.Lstat(path); err != nil {
+		t.Fatalf("accounting handler did not create socket: %v", err)
+	}
+	if err := h.Cleanup(); err != nil {
+		t.Fatalf("cleanup: %v", err)
+	}
+	if _, err := os.Lstat(path); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("cleanup must release final socket: %v", err)
+	}
+}
