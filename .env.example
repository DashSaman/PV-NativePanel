PVNAIVE_LISTEN=127.0.0.1:8080
PVNAIVE_DB_HOST=127.0.0.1
PVNAIVE_DB_PORT=5432
PVNAIVE_DB_NAME=pvnaive
PVNAIVE_DB_USER=pvnaive_app
PGPASSFILE=/etc/pvnaive/db.pgpass
# Public Naive host[:port] used inside generated naive+https subscription entries.
# Set the real production hostname in the server environment; do not include a scheme or path.
PVNAIVE_NAIVE_PUBLIC_HOST=proxy.example.com
# Restart-safe periodic usage-reset scheduler. Defaults are shown explicitly;
# interval accepts 5..3600 seconds and batch limit accepts 1..100.
PVNAIVE_PERIODIC_RESET_INTERVAL_SECONDS=30
PVNAIVE_PERIODIC_RESET_BATCH_LIMIT=50
# Passwords, session secrets, encryption keys and real tokens never belong in
# this file. S03 creates the DB password with 256 bits of randomness and stores
# it only in the mode-0600 PGPASSFILE outside the Repository.
