# coverd-flip.caddyfile — R6-FLIP-001 reverse-proxy wiring (apply manually)
#
# Insert the @cover handle ABOVE the existing panel handle inside the node's
# site block, then `caddy validate` and `systemctl reload caddy`.
# Panel paths keep precedence: the cover NEVER intercepts panel/api traffic.
#
# --- begin snippet ---
# @cover not path /panel /panel/* /api/v1/* /api/v1/health/* /pvnaive-mark.svg
# handle @cover {
# 	# Cover site (R6): loopback coverd inside the pvnaive container.
# 	# Fail-closed: if coverd is down the proxy returns its own 404 —
# 	# never a 502 that hints at the panel behind it.
# 	reverse_proxy 127.0.0.1:9444 {
# 		health_timeout 3s
# 	}
# 	header {
# 		# Hygiene parity with coverd's own headers (CAMO-001):
# 		-Server
# 		Server "web"
# 		-Set-Cookie
# 		X-Content-Type-Options "nosniff"
# 		Referrer-Policy "no-referrer"
# 	}
# }
# --- end snippet ---
#
# Ordering example inside the site block:
#
# 	example.node.domain {
# 		@cover not path /panel /panel/* /api/v1/* /api/v1/health/* /pvnaive-mark.svg
# 		handle @cover { ... snippet above ... }
# 		handle /panel* { reverse_proxy 127.0.0.1:8080 }
# 		handle /api/v1/* { reverse_proxy 127.0.0.1:8080 }
# 		# ... existing panel handles ...
# 	}
#
# Rollback: unset PVNAIVE_COVERD_ENABLED and recreate the container; coverd
# stops listening and the proxy's own 404 takes over for cover paths. The
# snippet can then be removed at the next Caddy maintenance reload.
