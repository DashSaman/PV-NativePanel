[Unit]
Description=PVNaive management API
After=network-online.target postgresql.service pvnaive-runtime-agent.service
Wants=network-online.target pvnaive-runtime-agent.service

[Service]
Type=simple
User=pvnaive
Group=pvnaive
SupplementaryGroups=pvnaive-session-control
EnvironmentFile=/etc/pvnaive/db.env
EnvironmentFile=-/etc/pvnaive/api.env
Environment=PVNAIVE_AUTH_KEY_FILE=/etc/pvnaive/auth.key
Environment=PVNAIVE_RUNTIME_KEY_FILE=/etc/pvnaive/runtime.key
Environment=PVNAIVE_RUNTIME_KEY_ID=runtime-v1
Environment=PVNAIVE_RUNTIME_AGENT_SOCKET=/run/pvnaive/runtime-agent.sock
Environment=PVNAIVE_LISTEN=127.0.0.1:8080
ExecStart=/opt/pvnaive/bin/pvnaive
Restart=on-failure
RestartSec=3s
TimeoutStartSec=20s
TimeoutStopSec=20s
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=multi-user.target
