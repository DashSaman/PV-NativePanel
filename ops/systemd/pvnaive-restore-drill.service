[Unit]
Description=PVNaive encrypted backup restore drill
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/pvnaive/ops/restore-drill.sh
UMask=0077
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/pvnaive /var/run/postgresql
ReadOnlyPaths=/etc/pvnaive /opt/pvnaive
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
